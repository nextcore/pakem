{
  "Pakem If": {
    "prefix": "@if",
    "body": [
      "@if(${1:condition})",
      "\t$0",
      "@endif"
    ],
    "description": "Pakem If directive"
  },
  "Pakem Foreach": {
    "prefix": "@foreach",
    "body": [
      "@foreach(${1:items} as ${2:item})",
      "\t$0",
      "@endforeach"
    ],
    "description": "Pakem Foreach directive"
  },
  "Pakem Extends": {
    "prefix": "@extends",
    "body": "@extends('${1:layout}')",
    "description": "Pakem Extends layout"
  },
  "Pakem Section": {
    "prefix": "@section",
    "body": [
      "@section('${1:content}')",
      "\t$0",
      "@endsection"
    ],
    "description": "Pakem Section block"
  },
  "Pakem Yield": {
    "prefix": "@yield",
    "body": "@yield('${1:content}')",
    "description": "Pakem Yield content"
  },
  "Pakem CSRF": {
    "prefix": "@csrf",
    "body": "@csrf",
    "description": "Pakem CSRF hidden input"
  },
  "Tera Print": {
    "prefix": "{{",
    "body": "{{ ${1:variable} }}",
    "description": "Tera print variable"
  },
  "Tera Tag": {
    "prefix": "{%",
    "body": "{% ${1:tag} %}",
    "description": "Tera control tag"
  }
}
