{
  "Pakem Application Prelude Import": {
    "prefix": ["l-prelude", "pakem.prelude"],
    "body": [
      "use crate::app::prelude::*;"
    ],
    "description": "Import Pakem Application Prelude (All Models, Requests, PakemResult, and Request)"
  },
  "Pakem Framework Prelude Import": {
    "prefix": ["l-import", "pakem.import"],
    "body": [
      "use pakem::prelude::*;",
      "use crate::app::models::*;"
    ],
    "description": "Import Pakem core prelude and application models"
  },
  "Pakem Controller": {
    "prefix": ["l-ctrl", "pakem.controller"],
    "body": [
      "use pakem::prelude::*;",
      "use crate::app::models::*;",
      "",
      "pub struct ${1:Resource}Controller;",
      "",
      "impl ${1:Resource}Controller {",
      "\t/// GET /${2:resources} — List all records",
      "\tpub async fn index(req: Request) -> PakemResult {",
      "\t\tlet data = ${1:Resource}::all(req.db()).await?;",
      "\t\treq.ok(data)",
      "\t}",
      "",
      "\t/// GET /${2:resources}/paged — Paginated list (?page=1&per_page=10)",
      "\tpub async fn paginate(req: Request) -> PakemResult {",
      "\t\tlet (page, per_page) = req.pagination();",
      "\t\tlet paginator = ${1:Resource}::paginate(req.db(), page, per_page).await?;",
      "\t\treq.paginate(paginator)",
      "\t}",
      "",
      "\t/// GET /${2:resources}/:id — Show single record",
      "\tpub async fn show(req: Request) -> PakemResult {",
      "\t\tlet id = req.id_or_fail()?;",
      "\t\tmatch ${1:Resource}::find(req.db(), id).await? {",
      "\t\t\tSome(item) => req.ok(item),",
      "\t\t\tNone => req.not_found(\"${1:Resource} tidak ditemukan\"),",
      "\t\t}",
      "\t}",
      "",
      "\t/// POST /${2:resources} — Create new record",
      "\tpub async fn store(req: Request, ValidatedJson(mut item): ValidatedJson<${1:Resource}>) -> PakemResult {",
      "\t\tlet id = item.save(req.db()).await?;",
      "\t\titem.id = id;",
      "\t\treq.created_with(item, \"${1:Resource} berhasil dibuat\")",
      "\t}",
      "",
      "\t/// PUT /${2:resources}/:id — Update record",
      "\tpub async fn update(req: Request, ValidatedJson(payload): ValidatedJson<${1:Resource}>) -> PakemResult {",
      "\t\tlet id = req.id_or_fail()?;",
      "\t\tlet mut item = match ${1:Resource}::find(req.db(), id).await? {",
      "\t\t\tSome(i) => i,",
      "\t\t\tNone => return req.not_found(\"${1:Resource} tidak ditemukan\"),",
      "\t\t};",
      "\t\t// item.name = payload.name;",
      "\t\titem.save(req.db()).await?;",
      "\t\treq.success(item, \"${1:Resource} berhasil diperbarui\")",
      "\t}",
      "",
      "\t/// DELETE /${2:resources}/:id — Soft delete record",
      "\tpub async fn destroy(req: Request) -> PakemResult {",
      "\t\tlet id = req.id_or_fail()?;",
      "\t\tif ${1:Resource}::destroy(req.db(), id).await? {",
      "\t\t\treq.success(serde_json::json!({ \"id\": id }), \"${1:Resource} berhasil dihapus\")",
      "\t\t} else {",
      "\t\t\treq.not_found(\"${1:Resource} tidak ditemukan\")",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Generate a complete Pakem RESTful Controller with PakemResult"
  },
  "Pakem Action / Handler": {
    "prefix": ["l-action", "pakem.action"],
    "body": [
      "/// ${1:Method} /${2:path}",
      "pub async fn ${3:action_name}(req: Request) -> PakemResult {",
      "\t$0",
      "\treq.ok(serde_json::json!({ \"status\": \"success\" }))",
      "}"
    ],
    "description": "Generate a single Pakem controller handler returning PakemResult"
  },
  "Pakem Model": {
    "prefix": ["l-model", "pakem.model"],
    "body": [
      "use pakem::prelude::*;",
      "use serde::{Deserialize, Serialize};",
      "use sqlx::FromRow;",
      "",
      "// =========================================================================",
      "//  ${1:Model} MODEL (Pakem Eloquent / Active Record)",
      "// =========================================================================",
      "",
      "#[derive(Debug, Serialize, Deserialize, FromRow, Clone, Default, PakemModel)]",
      "#[pakem(table = \"${2:table_name}\")]",
      "pub struct ${1:Model} {",
      "\tpub id: i64,",
      "\tpub ${3:name}: String,",
      "",
      "\tpub created_at: Option<String>,",
      "\tpub updated_at: Option<String>,",
      "\tpub deleted_at: Option<String>,",
      "}",
      "",
      "impl ${1:Model} {",
      "\tpub fn new() -> Self {",
      "\t\tSelf::default()",
      "\t}",
      "}"
    ],
    "description": "Generate a Pakem Eloquent Active Record model struct"
  },
  "Pakem Paginate Action": {
    "prefix": ["l-paginate", "pakem.paginate"],
    "body": [
      "let (page, per_page) = req.pagination();",
      "let paginator = ${1:Model}::paginate(req.db(), page, per_page).await?;",
      "req.paginate(paginator)"
    ],
    "description": "Paginate records automatically using req.pagination()"
  },
  "Pakem Find Record": {
    "prefix": ["l-find", "pakem.find"],
    "body": [
      "match ${1:Model}::find(req.db(), ${2:id}).await? {",
      "\tSome(${3:item}) => req.ok(${3:item}),",
      "\tNone => req.not_found(\"${1:Model} tidak ditemukan\"),",
      "}"
    ],
    "description": "Find single record with graceful 404 response"
  },
  "Pakem Active Record Save": {
    "prefix": ["l-save", "pakem.save"],
    "body": [
      "${1:item}.save(req.db()).await?;"
    ],
    "description": "Save instance to database (INSERT if id == 0, UPDATE if id > 0)"
  },
  "Pakem Destroy Record": {
    "prefix": ["l-destroy", "pakem.destroy"],
    "body": [
      "${1:Model}::destroy(req.db(), ${2:id}).await?;"
    ],
    "description": "Soft delete a record by ID"
  },
  "Pakem Query Builder Where": {
    "prefix": ["l-where", "pakem.where"],
    "body": [
      "${1:Model}::where_eq(req.db(), \"${2:column}\", ${3:value}).get().await?"
    ],
    "description": "Query records using where_eq"
  },
  "Pakem API Routes Resource": {
    "prefix": ["l-routes-crud", "pakem.routes.crud"],
    "body": [
      "Router::new()",
      "\t.get(\"/${1:resources}\", ${2:Resource}Controller::index)",
      "\t.get(\"/${1:resources}/paged\", ${2:Resource}Controller::paginate)",
      "\t.post(\"/${1:resources}\", ${2:Resource}Controller::store)",
      "\t.get(\"/${1:resources}/:id\", ${2:Resource}Controller::show)",
      "\t.put(\"/${1:resources}/:id\", ${2:Resource}Controller::update)",
      "\t.delete(\"/${1:resources}/:id\", ${2:Resource}Controller::destroy)"
    ],
    "description": "Define full RESTful CRUD routes in Router"
  },
  "Pakem Relationship Has Many": {
    "prefix": ["l-has-many", "pakem.has_many"],
    "body": [
      "has_many!(${1:items}: ${2:RelatedModel});"
    ],
    "description": "Declare HasMany relationship in 1 line (Laravel-style)"
  },
  "Pakem Relationship Belongs To": {
    "prefix": ["l-belongs-to", "pakem.belongs_to"],
    "body": [
      "belongs_to!(${1:parent}: ${2:ParentModel}, ${3:parent_id});"
    ],
    "description": "Declare BelongsTo relationship in 1 line (Laravel-style)"
  },
  "Pakem Relationship Has One": {
    "prefix": ["l-has-one", "pakem.has_one"],
    "body": [
      "has_one!(${1:detail}: ${2:RelatedModel});"
    ],
    "description": "Declare HasOne relationship in 1 line (Laravel-style)"
  },
  "Pakem Relationship Belongs To Many": {
    "prefix": ["l-belongs-to-many", "pakem.belongs_to_many"],
    "body": [
      "belongs_to_many!(${1:tags}: ${2:RelatedModel}, \"${3:pivot_table}\");"
    ],
    "description": "Declare BelongsToMany (Many-to-Many) relationship in 1 line via pivot table"
  },
  "Pakem Relationship Function (Manual)": {
    "prefix": ["l-rel-fn", "pakem.rel_fn"],
    "body": [
      "pub async fn ${1:author}(&self, db: &Db) -> OrmResult<${2:User}> {",
      "\tself.belongs_to(db, self.${3:user_id}).await",
      "}"
    ],
    "description": "Define relationship as a clean method with &Db and OrmResult"
  },
  "Pakem Query Builder Where Has": {
    "prefix": ["l-where-has", "pakem.where_has"],
    "body": [
      "${1:Model}::where_has(req.db(), \"${2:relation_table}\", \"${3:foreign_key}\", \"${4:id}\").get().await?"
    ],
    "description": "Filter records by relationship existence (whereHas)"
  }
}
