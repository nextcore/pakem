{
  "name": "pakem-vscode",
  "displayName": "Pakem Framework (IDE Support & Blade Snippets)",
  "description": "Official Pakem Framework tooling: Eloquent models, beautiful controllers, RESTful routing, and Blade template syntax highlighting.",
  "version": "0.2.0",
  "publisher": "pakem",
  "author": "Slamet Sugandi <packercyber@gmail.com>",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pakem",
        "aliases": ["Pakem", "pakem"],
        "extensions": [".blade.rs", ".html"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pakem",
        "scopeName": "text.html.pakem",
        "path": "./syntaxes/pakem.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pakem",
        "path": "./snippets/pakem.json"
      },
      {
        "language": "html",
        "path": "./snippets/pakem.json"
      },
      {
        "language": "rust",
        "path": "./snippets/rust.json"
      }
    ]
  }
}
