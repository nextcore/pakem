# ─── PAKEM FRAMEWORK CONFIGURATION ──────────────────────────────────────────

# Application Settings
APP_NAME=Pakem
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=pakem-super-secret-key-change-me-in-production

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# OAuth2 (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:8000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://127.0.0.1:8000/auth/github/callback

# Database Configuration (Laravel Style - Tidak perlu DATABASE_URL yang panjang!)
DB_CONNECTION=sqlite
DB_DATABASE=./database.sqlite

# Atau untuk MySQL / MariaDB:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pakem_db
# DB_USERNAME=root
# DB_PASSWORD=secret

# Atau untuk PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=pakem_db
# DB_USERNAME=postgres
# DB_PASSWORD=secret

# Atau untuk Microsoft SQL Server (MSSQL):
# DB_CONNECTION=sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_DATABASE=pakem_db
# DB_USERNAME=sa
# DB_PASSWORD=YourPassword123

# Opsional: Jika ingin menggunakan URL eksplisit (jika ada, DB_* diabaikan):
# DATABASE_URL=sqlite:./database.sqlite

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# ─── UNIVERSAL STORAGE (FILESYSTEM) ──────────────────────────────────────────
# Pilihan default disk: local | public | s3
FILESYSTEM_DISK=local
UPLOAD_MAX_SIZE_MB=10

# Konfigurasi S3 / Cloudflare R2 / MinIO / RustFS (Hanya diperlukan jika FILESYSTEM_DISK=s3)
# Contoh RustFS Lokal:
AWS_ACCESS_KEY_ID=3gRyLecCYz1qh4IQwz3y
AWS_SECRET_ACCESS_KEY=MIgR3dJNYtxLCBfljXil2sFSZKP9dM5Rqcb1cYMn
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=pakem-test
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_URL=https://cdn.example.com # Custom public CDN domain

# ─── REDIS MULTI-DRIVER SUITE ────────────────────────────────────────────────
# URL Redis terpusat untuk Cache, Queue, dan WebSocket Broadcaster
REDIS_URL="redis://127.0.0.1:6379/0"

# Cache Driver: moka (in-memory) | redis
CACHE_DRIVER=moka

# Queue Driver: database | redis
QUEUE_CONNECTION=database

# Broadcaster Driver: log | redis
BROADCAST_DRIVER=log
