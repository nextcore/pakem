# ─── PAKEM FRAMEWORK CONFIGURATION ──────────────────────────────────────────

# Application Settings
APP_NAME=Pakem
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=pakem-super-secret-key-change-me-in-production

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# OAuth2 (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:8000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://127.0.0.1:8000/auth/github/callback

# Database Configuration (Laravel Style)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=./pakem.db
DB_USERNAME=root
DB_PASSWORD=

# Atau gunakan URL eksplisit (jika DATABASE_URL ada, maka variabel DB_* diabaikan)
# DATABASE_URL=sqlite:database.sqlite
# DATABASE_URL=postgres://postgres:password@localhost:5432/pakem_db
# DATABASE_URL=mysql://root:pass@127.0.0.1:3306/pakem_db
#
# Microsoft SQL Server (MSSQL) Connection Options:
# 1. URL Format (Standard):
# DATABASE_URL="sqlserver://sa:YourPassword123@localhost:1433?database=pakem_db&trustServerCertificate=true"
# 2. JDBC Format - IP:Port Langsung (Paling Cepat / Direkomendasikan untuk Enterprise):
# DATABASE_URL="jdbc:sqlserver://192.168.10.29:1433;user=sa;password=123;database=DBSIMRS;trustServerCertificate=true"
# 3. JDBC Format - Named Instance (Wajib gunakan double backslash \\ di file .env):
# DATABASE_URL="jdbc:sqlserver://192.168.10.29\\SQL2012;user=sa;password=123;database=DBSIMRS;trustServerCertificate=true"
# 4. ADO Format:
# DATABASE_URL="Server=192.168.10.29,1433;Database=DBSIMRS;User Id=sa;Password=123;TrustServerCertificate=true;"

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# ─── UNIVERSAL STORAGE (FILESYSTEM) ──────────────────────────────────────────
# Pilihan default disk: local | public | s3
FILESYSTEM_DISK=local
UPLOAD_MAX_SIZE_MB=10

# Konfigurasi S3 / Cloudflare R2 / MinIO / RustFS (Hanya diperlukan jika FILESYSTEM_DISK=s3)
# Contoh RustFS Lokal:
AWS_ACCESS_KEY_ID=3gRyLecCYz1qh4IQwz3y
AWS_SECRET_ACCESS_KEY=MIgR3dJNYtxLCBfljXil2sFSZKP9dM5Rqcb1cYMn
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=pakem-test
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_URL=https://cdn.example.com # Custom public CDN domain

# ─── REDIS MULTI-DRIVER SUITE ────────────────────────────────────────────────
# URL Redis terpusat untuk Cache, Queue, dan WebSocket Broadcaster
REDIS_URL="redis://127.0.0.1:6379/0"

# Cache Driver: moka (in-memory) | redis
CACHE_DRIVER=moka

# Queue Driver: database | redis
QUEUE_CONNECTION=database

# Broadcaster Driver: log | redis
BROADCAST_DRIVER=log
