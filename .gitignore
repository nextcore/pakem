# ============================================
# Pakem Framework - .gitignore
# ============================================

# --- Rust Build Output ---
# Folder ini berisi hasil kompilasi, JANGAN dicommit
/target/
Cargo.lock

# --- Environment Variables & Secrets ---
# File .env berisi secret/config lokal, JANGAN dicommit
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.pfx
*.p12
*.cer
*.der
*.secret

# --- Database Dumps & Local Databases ---
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
database/dumps/
database/backups/
storage/backups/
backup/
backups/

# --- Storage, Logs & Uploads ---
storage/logs/
storage/cache/*
!storage/cache/.gitkeep
storage/app/public/uploads/*
!storage/app/public/uploads/.gitkeep
storage/app/private/*
!storage/app/private/.gitkeep
.pakem_tinker_history
*.log

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- AI Agents & IDE Context ---
.antigravity/
.ai_scratch/
.cursor/
.windsurf/

# --- Temporary Files ---
*.tmp
*.bak
*.exe

# --- Local Test Project & Internal Work ---
/apptodolist/
/docs/history_pekerjaan/
/docs/planing_pekerjaan/
/skill_for_creates/
skill_for_createse.md
CRUD_TEST_REPORT.md
/docs/github_org_profile/
/docs_portal/
